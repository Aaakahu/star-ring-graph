# LightRAG server 配置 — 由插件设置面板自动写入
# 此文件为模板：LLM 字段留空，插件"应用并重启"按钮会基于面板填的值生成真正的 .env
#
# 重要：环境变量名对齐 lightrag-hku 1.5.4 的 config.py
#   - LLM_BINDING_HOST（不是 LLM_BASE_URL）
#   - EMBEDDING_BINDING_HOST（不是 EMBEDDING_BASE_URL）

# ============ LLM 配置（由插件面板写入）============
LLM_BINDING=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BINDING_HOST=

# ============ Embedding 配置（由插件面板写入）============
EMBEDDING_BINDING=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BINDING_HOST=

# ============ 存储配置（本地默认，不需改）============
LIGHTRAG_DATA_DIR=./rag_storage

# ============ Server 配置 =============
HOST=127.0.0.1
PORT=9620

# ============ 日志级别 =============
LIGHTRAG_LOG_LEVEL=INFO
MAX_ASYNC=4
