# LightRAG server 配置 — 由插件设置面板自动写入
# 此文件为模板：LLM 字段留空，插件"应用并重启"按钮会基于面板填的值生成真正的 .env
#
# 变量名覆盖 lightrag-hku 1.5.4 的所有读取路径（源码实证）：
#   - LLM 调用 openai.py:192 硬读 os.environ["OPENAI_API_KEY"]
#   - Embedding openai.py:1075 读 os.getenv("LLM_BINDING_API_KEY")
#   - config.py 读 LLM_BINDING_HOST / LLM_MODEL / EMBEDDING_BINDING_HOST
# 所以 LLM 的 key 要同时写 OPENAI_API_KEY + LLM_API_KEY + LLM_BINDING_API_KEY

# ============ LLM 配置（由插件面板写入）============
LLM_BINDING=openai
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BINDING_API_KEY=
LLM_MODEL=
LLM_BINDING_HOST=

# ============ Embedding 配置（由插件面板写入）============
EMBEDDING_BINDING=openai
EMBEDDING_API_KEY=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BINDING_HOST=

# ============ 存储配置（本地默认，不需改）============
LIGHTRAG_DATA_DIR=./rag_storage

# ============ Server 配置 =============
HOST=127.0.0.1
PORT=9620

# ============ 日志级别 =============
LIGHTRAG_LOG_LEVEL=INFO
MAX_ASYNC=4
